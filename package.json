{
  "name": "guess-party",
  "version": "0.1.0",
  "private": true,
  "description": "猜猜看：微信多人匿名投票猜測遊戲（Taro + 微信雲開發）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "typecheck": "tsc --noEmit",
    "cloud:install": "cd cloudfunctions/game && npm install",
    "cloud:build": "cd cloudfunctions/game && npm run build",
    "cloud:test": "cd cloudfunctions/game && npm test",
    "setup": "npm install && npm run cloud:install && npm run cloud:build"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.0.9",
    "@tarojs/helper": "4.0.9",
    "@tarojs/plugin-framework-react": "4.0.9",
    "@tarojs/plugin-platform-weapp": "4.0.9",
    "@tarojs/react": "4.0.9",
    "@tarojs/runtime": "4.0.9",
    "@tarojs/shared": "4.0.9",
    "@tarojs/taro": "4.0.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.0.9",
    "@tarojs/webpack5-runner": "4.0.9",
    "@types/node": "^18.19.0",
    "@types/react": "^18.2.0",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "4.0.9",
    "postcss": "^8.4.38",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0"
  }
}
